{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Documentaan",
  "version": "1.0.1",
  "identifier": "com.aashu9019.documentaan",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Documentaan",
        "width": 1280,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Aashu9019",
    "shortDescription": "Lightweight local PDF editor",
    "longDescription": "Documentaan (डकुमेन्टान) - view, annotate, sign and organise PDFs offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF Document", "description": "PDF Document", "mimeType": "application/pdf", "role": "Editor" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
